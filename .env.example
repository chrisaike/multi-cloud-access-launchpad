# =============================================================================
# Multi-Cloud Access Launchpad — environment configuration
# Copy this file to `.env.local` and fill in your Okta values.
# =============================================================================

# Auth mode: "mock" (default) runs a clearly-labeled Demo with no Okta needed.
# Set to "okta" to use real Okta OIDC (Authorization Code + PKCE).
VITE_AUTH_MODE=mock

# --- Okta OIDC settings (only used when VITE_AUTH_MODE=okta) -----------------
# Your Okta org authorization server issuer, e.g.
#   https://YOUR_ORG.okta.com/oauth2/default
VITE_OKTA_ISSUER=

# The Client ID of your Okta OIDC app (public SPA client — NO client secret).
VITE_OKTA_CLIENT_ID=

# Redirect URI registered in Okta. For local dev this is typically:
#   http://localhost:5173/login/callback
VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback

# Space-separated scopes. "groups" is needed so the dashboard can read
# the user's Okta groups claim for access mapping.
VITE_OKTA_SCOPES=openid profile email groups

# NOTE: This is a browser-based PUBLIC client. There is intentionally NO
# client secret here — never put secrets, refresh tokens, or cloud
# credentials in frontend env vars or code.
